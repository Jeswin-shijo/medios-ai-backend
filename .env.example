PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/medios_hospital
TZ=Asia/Kolkata

# Required. At least 32 random characters; the API refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Access tokens are short-lived; the refresh cookie renews them.
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Web app origins allowed to call the API (comma-separated; "*" is rejected).
CORS_ORIGIN=http://localhost:5173

# Refresh cookie. Secure is on by default when NODE_ENV=production; use
# COOKIE_SAMESITE=none (with COOKIE_SECURE=true) if the web app is on another site.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Brute-force protection: lock an account after this many failed sign-ins.
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# BCRYPT_ROUNDS=12

# Behind a reverse proxy, so rate limiting sees client IPs:
# TRUST_PROXY=true

# Swagger UI at /api/docs is off in production unless enabled:
# SWAGGER_ENABLED=true
