PORT=4000
NODE_ENV=development
# Required: the database the API uses. It refuses to start without one (there is no default).
MONGODB_URI=mongodb://localhost:27017/medios_hospital
TZ=Asia/Kolkata

# Required. At least 32 random characters; the API refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Access tokens are short-lived; the refresh cookie renews them.
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Web app origins allowed to call the API (comma-separated; "*" is rejected).
CORS_ORIGIN=http://localhost:5173

# Refresh cookie. Secure is on by default when NODE_ENV=production; use
# COOKIE_SAMESITE=none (with COOKIE_SECURE=true) if the web app is on another site.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Brute-force protection: lock an account after this many failed sign-ins.
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# BCRYPT_ROUNDS=12

# Behind a reverse proxy, so rate limiting sees client IPs:
# TRUST_PROXY=true

# Swagger UI at /api/docs is off in production unless enabled:
# SWAGGER_ENABLED=true

# Development: pin the clinic's "today" to the seeded demo day (like the web app's
# VITE_CLINIC_DATE), so "tomorrow's appointments" exist. Never set in production.
# CLINIC_DATE=2026-09-26

# AI suggestions (bed allocation).
# AI_PROVIDER: sample (default in development: canned answers, no AI service is
# called), claude (real AI; needs ANTHROPIC_API_KEY) or none (default in production).
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5
# Give up on the AI after this many milliseconds and fall back to the rules.
# AI_TIMEOUT_MS=8000

# Reception kiosk. SMS_PROVIDER / PAYMENT_PROVIDER: sample (default in development:
# nothing is sent or charged, screens are marked SAMPLE) or none (default in production).
# PUBLIC_WEB_URL: public web address used in patient tracking links.
# SMS_PROVIDER=sample
# PAYMENT_PROVIDER=sample
# PUBLIC_WEB_URL=https://medi-os-ai.vercel.app

# AI call agent (confirmation and booking calls).
# CALL_PROVIDER: simulated (default in development: no phone rings, outcomes are
# invented for testing), snapserve (real calls) or none (default in production).
# CALL_PROVIDER=snapserve
# SNAPSERVE_API_KEY=sk_live_...
# SNAPSERVE_CONFIRMATION_AGENT_ID=123
# SNAPSERVE_BOOKING_AGENT_ID=124
# Required with snapserve; give SnapServe the post-call URL
#   https://<api-host>/api/calls/webhook/snapserve?token=<CALL_WEBHOOK_SECRET>
# CALL_WEBHOOK_SECRET=replace-with-24-plus-random-characters
# Seconds between scheduler passes (0 = off); simulated call length in ms.
# CALL_SCHEDULER_INTERVAL_SECONDS=60
# CALL_SIMULATED_DELAY_MS=4000
